SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True

# Supabase PostgreSQL Connection String:
# In Supabase: Project Settings -> Database -> Connection string -> URI
# Mode "Transaction" (Port 6543) is recommended for serverless/Vercel/Render:
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres
# Or Session / Direct mode (Port 5432):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Kolkata

# Optional Admin Superuser Credentials
DJANGO_SUPERUSER_USERNAME=dhruvesh
DJANGO_SUPERUSER_PASSWORD=YourSecurePassword123!
DJANGO_SUPERUSER_EMAIL=nanapatil3636@gmail.com

